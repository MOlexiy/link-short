{
  "name": "@link-short/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/sync-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:explain": "tsx --env-file-if-exists=.env src/scripts/explain.ts"
  },
  "dependencies": {
    "bowser": "^2.14.1",
    "mongoose": "^9.11.2",
    "nanoid": "^5.1.6",
    "sst": "4.17.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "express": "^5.3.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
