# Used by the local Express server and scripts (not by deployed Lambdas —
# those read the linked SST secrets instead).
MONGODB_URI=mongodb://127.0.0.1:27017/link-short
VISITOR_SALT=local-dev-salt
PORT=4000
WEB_URL=http://localhost:3000
# Optional: public base used to build short URLs (defaults to the request host)
# SHORT_BASE_URL=https://lnk.example.com

# Abuse protection (defaults shown; 0 disables a limit)
# MAX_LINK_TTL_DAYS=0
# RATE_LIMIT_CREATE_PER_HOUR=10
# RATE_LIMIT_CREATE_PER_DAY=30
# RATE_LIMIT_GLOBAL_CREATE_PER_DAY=1000
# BLOCKED_DOMAINS=spam.example,evil.example
# SAFE_BROWSING_API_KEY=
